      "required": [
        "schemaVersion",
        "policyVersion",
        "evidenceSchemaVersion",
        "requiredArtifactKinds",
        "allowedMediaTypes",
        "maxArtifactBytes",
        "maxTotalBytes",
        "requiredRequirementIds",
        "explicitNonCompletionPhrases",
        "machineAssertionIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "cerbanimo.proof-policy/1.1.0"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSchemaVersion": {
          "const": "cerbanimo.evidence/1.1.0"
        },
        "requiredArtifactKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedMediaTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "requiredRequirementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "explicitNonCompletionPhrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "machineAssertionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ProofCheck": {
      "type": "object",
      "required": [
        "checkId",
        "passed",
        "reasonCode",
        "details"
      ],
      "properties": {
        "checkId": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ProofResult": {
      "type": "object",
      "required": [
        "schemaVersion",
        "taskId",
        "submissionId",
        "evidenceCycleId",
        "evidenceSchemaVersion",
        "evidenceDigest",
        "contentFingerprint",
        "policySchemaVersion",
        "policyVersion",
        "decision",
        "meaning",
        "truthClaim",
        "checks",
        "resultCodes",
        "evaluatedBy",
        "evaluatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "cerbanimo.proof-result/1.1.0"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "submissionId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceCycleId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSchemaVersion": {
          "const": "cerbanimo.evidence/1.1.0"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policySchemaVersion": {
          "const": "cerbanimo.proof-policy/1.1.0"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "pass",
            "reject"
          ]
        },
        "meaning": {
          "enum": [
            "eligible-for-independent-review",
            "structurally-ineligible"
          ]
        },
        "truthClaim": {
          "const": "none"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "checkId",
              "passed",
              "reasonCode",
              "details"
            ],
            "properties": {
              "checkId": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "reasonCode": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "resultCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evaluatedBy": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "rootIdentityId",
                "deviceId",
                "roles"
              ],
              "properties": {
                "kind": {
                  "const": "human"
                },
                "rootIdentityId": {
                  "type": "string",
                  "minLength": 1
                },
                "deviceId": {
                  "type": "string",
                  "minLength": 1
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "serviceId",
                "delegatedByRootIdentityId",
                "roles"
              ],
              "properties": {
                "kind": {
                  "const": "service"
                },
                "serviceId": {
                  "type": "string",
                  "minLength": 1
                },
                "delegatedByRootIdentityId": {
                  "type": "string",
                  "minLength": 1
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
